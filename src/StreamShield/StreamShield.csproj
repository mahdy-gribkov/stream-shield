    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>StreamShield</RootNamespace>
    <SupportedOSPlatform>windows10.0.19041.0</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreamShield.Tests" />
