bin/
obj/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.csproj.user
*.nupkg
*.snupkg
project.lock.json
*.nuget.props
*.nuget.targets
packages/
PublishProfiles/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
bld/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
[Dd]ebugPublic/

# .NET publish output
publish/

# User-specific files
*.rsuser
*.dbmdl
*.pfx
*.publishsettings

# Rider
.idea/
*.sln.iml

# JetBrains Rider cache
_ReSharper.Caches/

# -----------------------------------------------------------------------------
# Node.js (Browser Extension)
# -----------------------------------------------------------------------------
node_modules/
dist/
*.tgz
.npm
.eslintcache
*.log
npm-debug.log*

# Extension build artifacts
*.crx
*.xpi
web-ext-artifacts/

# -----------------------------------------------------------------------------
# Python (Linux)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl
.ruff_cache/
.mypy_cache/
.pytest_cache/

# -----------------------------------------------------------------------------
# Built Artifacts
# -----------------------------------------------------------------------------
*.exe
*.dll
*.pdb
*.msi

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# -----------------------------------------------------------------------------
# App Settings (user-specific, not in repo)
# -----------------------------------------------------------------------------
settings.json
appsettings.local.json
